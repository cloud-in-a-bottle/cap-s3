{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	# The OpenHost router forwards with Host rewritten to 127.0.0.1 but
	# preserves the real public host in X-Forwarded-Host. Restore it so
	# MinIO's SigV4 verification sees the same Host the client signed.
	@forwarded header X-Forwarded-Host *
	handle @forwarded {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host {http.request.header.X-Forwarded-Host}
		}
	}

	# Direct hits without X-Forwarded-Host (e.g. the platform health
	# probe) pass through with the incoming Host untouched.
	handle {
		reverse_proxy 127.0.0.1:9000
	}
}
